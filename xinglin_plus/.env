# ============================================================
# xinglin_plus 环境配置（本文件不入库；密钥优先读系统环境变量）
# ============================================================

# ---- Neo4j（沿用既有 medical 库）----
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=medical

# ---- Milvus（沿用既有服务与既有集合 medical_lit：762 条切片已就绪，直接复用）----
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=medical_lit

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HOURS=24

# ---- LLM（DeepSeek，OpenAI 兼容）----
# 密钥留空则自动读系统环境变量 DEEPSEEK_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TRUST_ENV=false

# ---- 第一代兜底链的 Qwen 兜底（默认关闭）----
FALLBACK_QWEN_ENABLED=false

# ---- 向量模型（本地 HF 缓存，384 维）----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
HF_HUB_OFFLINE=true
RETRIEVAL_TOP_K=8
RERANK_ENABLED=false

# ---- 事实护栏 ----
GUARDRAIL_ENABLED=true
GUARDRAIL_MAX_UNSUPPORTED_RATIO=0.4

# ---- 检索 / 切片 ----
# 稠密路相似度阈值（余弦，向量已归一化）；
# ⚠ 该值随嵌入模型而定：值越高召回越精、越少。0 表示不过滤。
SEARCH_SCORE_THRESHOLD=0.65
CHUNK_SIZE=600
CHUNK_OVERLAP=100
LOG_DIR=./logs
