# ==== Neo4j（问答链路建议使用只读账户）====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ==== Milvus / Redis ====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=medical_lit
REDIS_URL=redis://localhost:6379/0

# ==== LLM（OpenAI 兼容；DeepSeek 主 / Qwen 备）====
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# ==== Embedding / 检索 ====
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_ENABLED=false
RETRIEVAL_TOP_K=8

# ==== 缓存 / 日志 ====
CACHE_TTL_HOURS=24
LOG_DIR=./logs

# ==== 数据源 ====
KNOWLEDGE_TXT_PATH=../medical/medical/knowledge_base.txt
BM25_DOCS_PATH=data/bm25_docs.json
